# ============================================================
# CCXT MCP Server — configuration
# ============================================================
# Copy this file to mcp/ccxt/.env and fill in your credentials.
# WARNING: .env contains secrets. Never commit it.
#
# Safety posture: sandbox-first. Live money requires ALLOW_LIVE=true,
# DRY_RUN=false and an explicit arm_live_session() call.
# 8 pre-trade gates + idempotency + rate limiting.
# ============================================================

# Exchange: binance, bybit, okx, kraken, kucoin, hyperliquid...
CCXT_EXCHANGE=binance

# ── Sandbox / testnet ───────────────────────────────────────
# Binance testnet is free, no deposit needed.
# Get keys: https://testnet.binance.vision
CCXT_SANDBOX=true
CCXT_API_KEY=your_binance_testnet_api_key
CCXT_SECRET=your_binance_testnet_secret

# ── Live exchange ───────────────────────────────────────────
# Only fill when you are ready for real money (and never enable
# withdrawal permissions on the API key).
# CCXT_API_KEY=your_live_api_key
# CCXT_SECRET=your_live_secret
# CCXT_PASSWORD=            # passphrase for OKX / KuCoin (not needed on Binance)
#
# Check the venue's rules before trading a new exchange:
#   python scripts/exchange_profile.py profile --symbol BTC/USDT

# ── Safety gates ────────────────────────────────────────────
ALLOW_LIVE=false

# DRY_RUN logs what would happen but does NOT send orders.
DRY_RUN=true

# ── Order limits ────────────────────────────────────────────
MAX_ORDER_VALUE_USD=100        # Per-order cap in USD (0 = no limit)
MAX_SESSION_VALUE_USD=0        # Per-session cumulative cap (0 = no limit)
MIN_NOTIONAL_USD=10            # Minimum order notional in USD

# ── Price safety ────────────────────────────────────────────
MAX_SLIPPAGE_PCT=1.0           # Max slippage for market orders (%).
                               # Use limit orders to bypass this gate.

# ── Clock safety ────────────────────────────────────────────
CLOCK_MAX_DRIFT_MS=5000        # Max clock difference vs exchange (ms).
                               # Fix: w32tm /resync /force (Windows)

# ── Duplicate protection ────────────────────────────────────
DEDUP_WINDOW_SECONDS=30        # Reject identical orders within this window.

# ── Rate limiting ───────────────────────────────────────────
RATE_LIMIT_ORDER_SEC=2.0       # Minimum seconds between orders.
RATE_LIMIT_DATA_PER_SEC=10     # Max data requests per second.

# ── Live trading arming ─────────────────────────────────────
LIVE_MODE_REQUIRES_ARMING=true # Require arm_live_session() before real orders.

# ── Network ─────────────────────────────────────────────────
REQUEST_TIMEOUT_SECONDS=30
MAX_RETRIES=3
