# ============================================================
# Local environment — copy to .env in the repository root
# ============================================================
# Used by scanner.py, collector.py and scripts/*.py.
# .env is gitignored. Never commit real values.
# ============================================================

# AI-Trader agent identity
CLIPTAP_AI_TOKEN=your_ai_trader_token
CLIPTAP_AGENT_ID=0

# Push notifications (ntfy.sh). Use a long, hard-to-guess topic.
CLIPTAP_NTFY_TOPIC=change-me-to-a-random-topic

# Scanner: minutes to wait before repeating an alert for the same symbol.
ALERT_COOLDOWN_MIN=60

# Price-move alerts from the local event bus (state/events.jsonl).
PRICE_MOVE_PCT=1.0
PRICE_MOVE_WINDOW_MIN=15

# Collector intervals, in seconds
COLLECT_INTERVAL=300
HEARTBEAT_INTERVAL=60

# Risk engine (risk_engine.py)
# Arming live closes is deliberate: keep false until the engine has been
# validated in sandbox and paper, and the stop plans are trusted.
RISK_ENGINE_LIVE=false
RISK_POLL_INTERVAL=60
