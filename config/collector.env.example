# ============================================================
# Local environment — copy to .env in the repository root
# ============================================================
# Used by scanner.py, collector.py and scripts/*.py.
# .env is gitignored. Never commit real values.
# ============================================================

# AI-Trader agent identity
CLIPTAP_AI_TOKEN=your_ai_trader_token
CLIPTAP_AGENT_ID=0

# Push notifications (ntfy.sh). Use a long, hard-to-guess topic.
CLIPTAP_NTFY_TOPIC=change-me-to-a-random-topic

# Collector intervals, in seconds
COLLECT_INTERVAL=300
HEARTBEAT_INTERVAL=60
